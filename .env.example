# Copy to .env and fill in for local testing. Never commit the real .env.
# --- Secrets (required) ---
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Public feed URL (required) ---
# Where GitHub Pages serves this repo, no trailing slash.
PODCAST_BASE_URL=https://your-username.github.io/mena-daily-brief

# --- Optional tuning (sensible defaults if omitted) ---
PODCAST_TITLE=MENA Daily Brief
PODCAST_AUTHOR=Private Feed
PODCAST_EMAIL=noreply@example.com
# eleven_multilingual_v2 (best quality) | eleven_turbo_v2_5 | eleven_flash_v2_5 (cheapest/fastest)
ELEVENLABS_MODEL=eleven_multilingual_v2
# Prune episodes older than this many days.
ROLLING_WINDOW_DAYS=45
